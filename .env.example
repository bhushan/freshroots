# Copy to .env.local and fill in. Never commit real values.

# Neon Free. Use the POOLED connection string for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon direct (unpooled) connection string. Used by drizzle-kit migrations when set.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Single-admin gate. If ADMIN_PASSWORD is empty the app runs as a read-only demo.
ADMIN_PASSWORD=choose-a-long-passphrase
# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Gemini Developer API key from Google AI Studio (free tier only, no billing enabled).
GEMINI_API_KEY=
# Must be a model that is free of charge on your key. There is no automatic fallback.
GEMINI_MODEL=gemini-3.8-flash

# Optional AI guard rails (defaults shown).
AI_MAX_REQUESTS_PER_MINUTE=4
AI_MAX_REQUESTS_PER_DAY=40
AI_TIMEOUT_MS=20000

# Zoho Books (optional). Leave blank and approvals simply stay as proposals with the order pending.
# NOTE: Zoho's free plan appears not to include purchase orders; check your plan before relying on this.
# Data centre of your Zoho account: com, eu, in, com.au, jp, ca, sa or com.cn.
ZOHO_DC=
# Zoho Books organisation id (Settings > Organization Profile).
ZOHO_ORG_ID=
# Self Client from https://api-console.zoho.com (use your DC's console). Scopes needed:
# ZohoBooks.purchaseorders.CREATE, ZohoBooks.purchaseorders.READ, ZohoBooks.contacts.READ, ZohoBooks.settings.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Shared secret, at least 12 random characters. Zoho's webhook sends it as the x-webhook-secret header.
ZOHO_WEBHOOK_SECRET=
